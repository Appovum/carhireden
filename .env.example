# ═══════════════════════════════════════════════════════════════════
# CouponPilot — Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════

# Database Connection — PostgreSQL only
DATABASE_URL="postgresql://postgres:password@localhost:5432/couponpilot?schema=public"
# Used by `prisma db push` to create the tables. For a normal PostgreSQL server
# use the same value as DATABASE_URL. On a pooled provider (Neon, Supabase) use
# the DIRECT (non-pooled) connection string here.
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/couponpilot?schema=public"

# Docker Compose only: password for the bundled PostgreSQL container.
# Use letters and digits only (e.g. `openssl rand -hex 16`) — it is placed inside a URL.
# Docker Compose ignores DATABASE_URL above and connects to its own database.
POSTGRES_PASSWORD=""

# REQUIRED — Master App Secret (used for AES-256-GCM encryption at rest).
# Left empty on purpose: generate your own with  openssl rand -hex 32
# Never change it after you have saved network API keys or payout details —
# data encrypted with the old value can no longer be read.
APP_SECRET=""

# Bearer token that protects the cron endpoints (/api/cron/*). Leave empty to
# keep them disabled, or generate one with  openssl rand -hex 24
CRON_SECRET=""

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Docker Compose only: port to publish on the host (default 3000).
# APP_PORT=3000

# Public Live Demo Mode (Set to "true" for CodeCanyon live demo to restrict admin mutations/edits)
NEXT_PUBLIC_DEMO_MODE=false

# ── Affiliate Networks ────────────────────────────────────────────
# Optional here: these can also be entered in Admin → Networks, where they
# are stored encrypted in the database. Values set in the Admin UI take
# precedence over these env vars.

# Awin (https://ui.awin.com → Toolbox → API credentials)
AWIN_API_KEY=""
AWIN_PUBLISHER_ID=""

# CJ Affiliate (https://developers.cj.com → Personal Access Tokens; CID = your Publisher ID)
CJ_PERSONAL_ACCESS_TOKEN=""
CJ_PUBLISHER_ID=""

# Set to "true" to send real affiliate redirects. Leave "false" until your
# publisher IDs above (or in Admin → Networks) are configured.
ENABLE_LIVE_AFFILIATE_LINKS=false

# Optional: Google OAuth Credentials (managed via Admin UI or env)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Telegram Bot Credentials (for channel deal poster)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Stripe Secret Key & Publishable Key (from dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Optional: Webhook Secret (from dashboard.stripe.com/webhooks for auto-confirming orders)
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal API Credentials (from developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Mode: "sandbox" for testing, "live" for production
PAYPAL_MODE=sandbox

# ── SMTP Email Transport Credentials ──────────────────────────────
# Configure your SMTP credentials to enable transactional email dispatch (password reset, campaign notifications, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="you@example.com"
SMTP_PASS="your_app_password_here"
SMTP_FROM="CouponPilot <you@example.com>"

